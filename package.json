{
  "name": "btw-sidebar",
  "version": "1.3.1",
  "description": "Open BTW sessions in the native OpenChamber side chat.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FireKingY/ob-btw.git"
  },
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js && openchamber-guest-bundle --node service/main.ts service/main.js",
    "check": "openchamber-guest-check",
    "typecheck": "tsc --noEmit"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.0" },
    "id": "btw-sidebar",
    "name": "BTW",
    "icon": "chat-4",
    "contributes": {
      "panel": { "entry": "panel/index.html" },
      "capabilities": ["sessions"],
      "service": { "entry": "service/main.js", "runtime": "host" }
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.0"
  }
}
