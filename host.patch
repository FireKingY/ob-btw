+import type { HostReadyContext } from '@openchamber/sdk';
+import { isVSCodeRuntime } from '@/lib/desktop';
+import { isMobileSurfaceRuntime } from '@/lib/runtimeSurface';
+import { canCaptureGuestMicrophone } from './microphone';
+
+export function guestReadyFeatures(input: {
+  storageId?: string;
+  surface: HostReadyContext['surface'];
+  statusControls: boolean;
+  popover: boolean;
+  headless: boolean;
+}): NonNullable<HostReadyContext['features']> {
+  const features: NonNullable<HostReadyContext['features']> = { btwMetadata: true };
+  if (!isVSCodeRuntime() && !isMobileSurfaceRuntime()) features.sideChat = true;
+  if (input.storageId && globalThis.indexedDB) features.deviceStorage = true;
+  if (input.surface === 'status' && input.statusControls) features.statusControls = true;
+  if (!input.popover && !input.headless && !isVSCodeRuntime()
+    && (input.surface === 'panel' || input.surface === 'page' || input.surface === 'status')) features.popovers = true;
+  if (!input.headless) features.lateGenerateResults = true;
+  if (!input.headless && canCaptureGuestMicrophone()) features.microphone = true;
+  return features;
+}
diff --git a/packages/ui/src/lib/opencode/api-error.ts b/packages/ui/src/lib/opencode/api-error.ts
