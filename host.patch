+import { useShallow } from 'zustand/react/shallow';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useUIStore } from '@/stores/useUIStore';
+import { resolveChatPromptReadOnly } from '@/components/chat/chatPromptReadOnly';
+import { useSpaceArchiveOf } from '@/lib/spaces/space-archives';
+import { isVSCodeRuntime } from '@/lib/desktop';
+import { isMobileSurfaceRuntime } from '@/lib/runtimeSurface';
+
+export function useSideChatAvailable(): boolean {
+    const sessionId = useSessionUIStore((state) => state.currentSessionId);
+    const draftOpen = useSessionUIStore((state) => state.newSessionDraft.open);
+    const isMobile = useUIStore((state) => state.isMobile);
+    const allowSubagents = useUIStore((state) => state.allowPromptingSubagentSessions);
+    const { canPrompt, directory } = useGlobalSessionsStore(useShallow((state) => {
+        const source = sessionId ? state.entityById.get(sessionId) : undefined;
+        return {
+            canPrompt: Boolean(source && !resolveChatPromptReadOnly(source, allowSubagents, false)),
+            directory: source?.directory ?? null,
+        };
+    }));
+    const archive = useSpaceArchiveOf(directory);
+    return Boolean(canPrompt && !archive && !draftOpen && !isMobile && !isVSCodeRuntime() && !isMobileSurfaceRuntime());
+}
