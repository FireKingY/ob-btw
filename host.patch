diff --git a/packages/ui/src/components/chat/btw/BtwContextBanner.tsx b/packages/ui/src/components/chat/btw/BtwContextBanner.tsx
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/components/chat/btw/BtwContextBanner.tsx
@@ -0,0 +1,51 @@
+import React from 'react';
+import type { Session } from '@/lib/opencode/model';
+import { getBtwOriginalSessionID, getBtwSnapshotAt, getBtwSourceCompletedAt, getBtwSourceMessageID, isSideBtwSession } from '@/lib/sessionBtwMetadata';
+import { useSessionSelector } from '@/sync/sync-context';
+import { openSessionLink } from '@/lib/router/openSessionFromRoute';
+import { useI18n } from '@/lib/i18n';
+import { getCurrentIntlLocale } from '@/lib/i18n/intl';
+import { Icon } from '@/components/icon/Icon';
+import { Button } from '@/components/ui/button';
+import { Tooltip, TooltipContent, TooltipTrigger } from '@/components/ui/tooltip';
+
+const contextFields = (session: Session | undefined) => isSideBtwSession(session) ? {
+    parentId: getBtwOriginalSessionID(session),
+    messageId: getBtwSourceMessageID(session),
+    snapshotAt: getBtwSnapshotAt(session),
+    completedAt: getBtwSourceCompletedAt(session),
+} : null;
+
+const sameContextFields = (left: ReturnType<typeof contextFields>, right: ReturnType<typeof contextFields>) =>
+    left?.parentId === right?.parentId && left?.messageId === right?.messageId
+    && left?.snapshotAt === right?.snapshotAt && left?.completedAt === right?.completedAt;
+
+export function BtwContextBanner({ sessionId, directory }: { sessionId: string | null; directory?: string }) {
+    const { t } = useI18n();
+    const context = useSessionSelector(sessionId, directory, contextFields, sameContextFields);
+    if (!context?.parentId) return null;
+    const { parentId, messageId } = context;
+    const contextTime = context.snapshotAt ?? context.completedAt;
+    const time = contextTime ? new Date(contextTime).toLocaleString(getCurrentIntlLocale(), {
+        month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit',
+    }) : null;
+
+    return (
+        <div data-btw-context-boundary className="flex h-8 shrink-0 items-center gap-2 px-3 typography-meta text-muted-foreground">
+            <Icon name="git-branch" className="size-3.5 shrink-0" />
+            <Tooltip>
+                <TooltipTrigger asChild>
+                    <span className="min-w-0 flex-1 truncate" tabIndex={0}>
+                        {time ? t(context.snapshotAt ? 'chat.btw.context.createdAt' : 'chat.btw.context.snapshotAt', { time }) : t('chat.btw.context.snapshot')}
+                        {' · '}{t('chat.btw.context.noSync')}
+                    </span>
+                </TooltipTrigger>
+                <TooltipContent>{t('chat.btw.context.hint')}</TooltipContent>
+            </Tooltip>
+            <Button variant="ghost" size="xs" className="shrink-0"
+                onClick={() => { void openSessionLink(parentId, messageId); }}>
+                {t('chat.btw.context.source')}
+            </Button>
+        </div>
+    );
+}
