+import type { Session } from '@/lib/opencode/model';
+import { getLiveBtwRootSessionID } from '@/lib/sessionBtwMetadata';
+import { createChatDraftIdentity } from '@/lib/chatDraftPersistence';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { useInlineCommentDraftStore, type InlineCommentDraftTarget } from '@/stores/useInlineCommentDraftStore';
+import { useInputStore } from './input-store';
+
+export function captureRevertComposer(session: Session | undefined, sessionId: string, directory: string | undefined) {
+  const composerId = getLiveBtwRootSessionID(session) ?? sessionId;
+  const prevRestoreText = useInputStore.getState().pendingSessionRestores.get(composerId) ?? null;
+  const draftTarget: InlineCommentDraftTarget | null = directory ? { directory, sessionKey: composerId } : null;
+  const restoreIdentity = createChatDraftIdentity(getRuntimeKey(), directory, composerId);
+  const prevTargetAttachments = useInputStore.getState().getAttachedFiles(restoreIdentity);
+  const prevDrafts = draftTarget ? useInlineCommentDraftStore.getState().getDrafts(draftTarget) : [];
+  const restore = () => {
+    useInputStore.getState().setPendingSessionRestore(composerId, prevRestoreText);
+    useInputStore.getState().setAttachedFiles(prevTargetAttachments, restoreIdentity);
+    if (draftTarget) {
+      useInlineCommentDraftStore.getState().clearDrafts(draftTarget);
+      useInlineCommentDraftStore.getState().restoreDrafts(draftTarget, prevDrafts);
+    }
+  };
+  return { composerId, draftTarget, restoreIdentity, restore };
+}
