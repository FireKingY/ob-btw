+export const BTW_READ_ONLY_INSTRUCTION = `This BTW side conversation is read-only.
+Use tools only for read-only inspection.
+Do not write, edit, move, rename, or delete files.
+Do not execute commands that write files or cause other persistent changes.
+Do not change Git state, configuration, permissions, workspace state, or external data.
+Do not start or stop services, launch background work, or schedule jobs.
+Do not send messages to other people or services.
+Do not publish or deploy anything.
+Do not request broader access or escalated permissions.
+If a request requires changes, describe the changes for the main chat.
+Do not execute those changes in this side conversation.
+An edit request inside BTW does not lift these restrictions.`;
diff --git a/packages/ui/src/lib/liveBtw.ts b/packages/ui/src/lib/liveBtw.ts
new file mode 100644
index 0000000..2596f0f
--- /dev/null
+++ b/packages/ui/src/lib/liveBtw.ts
@@ -0,0 +1,83 @@
+import type { Session } from '@/lib/opencode/model';
+import { opencodeClient } from '@/lib/opencode/client';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { registerSessionDirectory } from '@/sync/sync-refs';
+import * as sessionActions from '@/sync/session-actions';
+import { insertForkIntoDirectoryStore, btwSessionTitle, type StartBtwInput } from '@/lib/btw';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useSelectionStore } from '@/sync/selection-store';
+import { DraftSendError, useSessionUIStore } from '@/sync/session-ui-store';
+import { usePermissionStore } from '@/stores/permissionStore';
+import { permissionModeForNewSession } from '@/stores/utils/permissionAutoAccept';
+import { useUIStore } from '@/stores/useUIStore';
+import { isSpaceDirectory } from '@/lib/spaces/space-route';
+import { getLiveBtwRootSessionID, isCoordinatedLiveBtwSession } from '@/lib/sessionBtwMetadata';
+
+const admit = (session: Session, directory: string) => {
+  registerSessionDirectory(session.id, session.directory ?? directory);
+  useGlobalSessionsStore.getState().upsertSession(session);
+  insertForkIntoDirectoryStore(session, session.directory ?? directory);
+};
+
+export async function prepareLiveBtwTurn(input: { sessionId?: string; parentSessionId?: string; directory: string; runtimeKey: string }) {
+  const source = input.sessionId ? useGlobalSessionsStore.getState().entityById.get(input.sessionId) : undefined;
+  const sourceRoot = getLiveBtwRootSessionID(source);
+  const migratePermissions = input.sessionId && sourceRoot && sourceRoot !== input.sessionId
+    && !isCoordinatedLiveBtwSession(source);
+  const permissionMode = migratePermissions ? usePermissionStore.getState().getSessionMode(input.sessionId!) : undefined;
+  const rootMode = sourceRoot ? usePermissionStore.getState().getSessionMode(sourceRoot) : undefined;
+  const turn = await opencodeClient.prepareLiveBtw({
+    sessionID: input.sessionId, parentSessionID: input.parentSessionId, directory: input.directory, runtimeKey: input.runtimeKey,
+    materialize: async (session) => {
+      if (getRuntimeKey() !== input.runtimeKey) throw new Error('runtime changed');
+      admit(session, input.directory);
+      await sessionActions.refetchSessionMessages(session.id);
+    },
+  });
+  try {
+    if (getRuntimeKey() !== input.runtimeKey) throw new Error('runtime changed');
+    admit(turn.root, input.directory);
+    if (permissionMode !== undefined && usePermissionStore.getState().getSessionMode(turn.root.id) === rootMode && rootMode !== permissionMode) {
+      await usePermissionStore.getState().setSessionMode(turn.root.id, usePermissionStore.getState().getSessionMode(input.sessionId!));
+    }
+    if (getRuntimeKey() !== input.runtimeKey) throw new Error('runtime changed');
+    return turn;
+  } catch (error) {
+    await turn.finish(false).catch(() => {});
+    throw error;
+  }
+}
+
+export async function startLiveBtwSession(input: StartBtwInput): Promise<Session> {
+  const runtimeKey = input.expectedRuntimeKey ?? getRuntimeKey();
+  const turn = await prepareLiveBtwTurn({ parentSessionId: input.parentSessionId, directory: input.directory, runtimeKey });
+  let accepted = false;
+  try {
+    const selections = useSelectionStore.getState();
+    for (const sessionID of [turn.root.id, turn.session.id]) {
+      selections.saveSessionModelSelection(sessionID, input.providerID, input.modelID);
+      if (input.agent) {
+        selections.saveSessionAgentSelection(sessionID, input.agent);
+        selections.saveAgentModelVariantForSession(sessionID, input.agent, input.providerID, input.modelID, input.variant);
+      }
+    }
+    const mode = permissionModeForNewSession(input.permissionMode, isSpaceDirectory(input.directory), useUIStore.getState().permissionDefaultMode);
+    if (mode !== undefined) {
+      await usePermissionStore.getState().setSessionMode(turn.root.id, mode);
+    }
+    await sessionActions.updateSessionTitle(turn.root.id, btwSessionTitle(input.question, 'live'), { directory: input.directory, expectedRuntimeKey: runtimeKey });
+    if (input.question.trim() || input.attachments?.length || input.additionalParts?.length) {
+      await useSessionUIStore.getState().sendMessage(input.question, input.providerID, input.modelID, input.agent,
+        input.attachments ?? [], undefined, input.additionalParts, input.variant ?? undefined, 'normal', {
+          target: { runtimeKey, sessionId: turn.session.id, directory: input.directory },
+          skills: input.skills, liveBtwPrepared: true,
+        });
+      accepted = true;
+    }
+    return turn.session;
+  } catch (error) {
+    throw new DraftSendError(turn.session.id, input.directory, true, error);
+  } finally {
+    await turn.finish(accepted).catch((error) => console.warn('Live BTW completion remains pending:', error));
+  }
+}
