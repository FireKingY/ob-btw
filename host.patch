--- /dev/null
+++ b/packages/sdk/src/btw-rpc.ts
@@ -0,0 +1,26 @@
+/** Shared wire contract for the optional native BTW coordinator. No model-facing tools are registered. */
+const string = { type: 'string', minLength: 1 } as const;
+type RpcField = typeof string | { type: 'boolean' };
+const input = (properties: Record<string, RpcField>, required: string[]) => ({
+  type: 'object', properties, required, additionalProperties: false,
+});
+const output = { type: 'object', additionalProperties: true };
+const errors = {
+  conflict: { type: 'object', additionalProperties: true },
+  unavailable: { type: 'object', additionalProperties: true },
+};
+
+export const LIVE_BTW_RPC = {
+  id: 'openchamber.btw',
+  events: {},
+  methods: {
+    reserve: { input: input({ parentSessionID: string, sessionID: string, requestID: string }, ['requestID']), output, errors },
+    publish: { input: input({ rootSessionID: string, sessionID: string, token: string }, ['rootSessionID', 'sessionID', 'token']), output, errors },
+    track: { input: input({ rootSessionID: string, token: string, temporarySessionID: string, candidateSessionID: string }, ['rootSessionID', 'token', 'temporarySessionID', 'candidateSessionID']), output, errors },
+    finish: { input: input({ rootSessionID: string, token: string, accepted: { type: 'boolean' } }, ['rootSessionID', 'token', 'accepted']), output, errors },
+    retired: { input: input({ rootSessionID: string, sessionID: string }, ['rootSessionID', 'sessionID']), output, errors },
+    resolve: { input: input({ sessionID: string, messageID: string }, ['sessionID']), output, errors },
+    status: { input: input({}, []), output, errors },
+    snapshot: { input: input({ sessionID: string, parentSessionID: string }, ['sessionID', 'parentSessionID']), output, errors },
+  },
+} as const;
