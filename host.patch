+import { describe, expect, test } from 'bun:test';
+import type { SessionMessageInfo } from '@opencode/client';
+import { buildLiveBtwMessages, collectLiveBtwTurns, liveBtwBasis } from './live-btw-context';
+
+type Assistant = Extract<SessionMessageInfo, { type: 'assistant' }>;
+const user = (id: string, text: string): Extract<SessionMessageInfo, { type: 'user' }> => ({
+  id, type: 'user', text, time: { created: 10 },
+});
+const assistant = (id: string, text: string): Assistant => ({
+  id, type: 'assistant', agent: 'build', model: { providerID: 'fixture', id: 'model' },
+  content: [{ type: 'text', text, native: { reference: id } }], finish: 'stop', time: { created: 11, completed: 12 },
+});
+const basis = { messageID: 'main-answer', text: 'Main progress at the original question.', snapshotAt: 15, completed: true };
+const end: SessionMessageInfo = {
+  id: 'basis', type: 'synthetic', text: 'End of replay.', time: { created: 15 },
+  metadata: { openchamberLiveBtwBasis: basis },
+};
+const input = { start: 'LIVE_START', end: 'LIVE_END', snapshotAt: 20 };
+
+describe('live BTW native context', () => {
+  test('replays only side questions and final answer text with their original premise', () => {
+    const answer = assistant('side-final', 'The final answer.');
+    answer.content = [{ type: 'reasoning', text: 'PRIVATE_SIDE_REASONING' }, ...answer.content];
+    const work: Assistant = { ...assistant('side-work', 'SIDE_WORK_IN_PROGRESS'), finish: 'tool-calls', content: [{
+      type: 'tool', id: 'call-side', name: 'read', time: { created: 11, completed: 12 },
+      state: { status: 'completed', input: { path: 'file' }, content: [{ type: 'text', text: 'SIDE_TOOL_OUTPUT' }] },
+    }] };
+    const turns = collectLiveBtwTurns([user('main-user', 'MAIN_TASK'), end, user('side-user', 'Side question'), work, answer], 'main-user');
+    expect(turns).toHaveLength(1);
+    expect(turns[0].basis).toEqual(basis);
+    expect(turns[0].answer?.content).toEqual([{ type: 'text', text: 'The final answer.' }]);
+    const next = buildLiveBtwMessages({ ...input, snapshot: [user('new-main', 'LATEST_MAIN')], turns });
+    const text = JSON.stringify(next.messages);
+    expect(text).toContain('LATEST_MAIN');
+    expect(text).toContain('Main progress at the original question.');
+    expect(text).toContain('Side question');
+    expect(text).toContain('The final answer.');
+    expect(text).not.toContain('PRIVATE_SIDE_REASONING');
+    expect(text).not.toContain('SIDE_TOOL_OUTPUT');
+    expect(text).not.toContain('SIDE_WORK_IN_PROGRESS');
+  });
+
+  test('keeps every main content field intact and does not mutate a running snapshot', () => {
+    const running: Assistant = { ...assistant('running', 'Current main progress'), time: { created: 19 }, native: { provider: 'opaque' } };
+    running.content.push({ type: 'reasoning', text: 'MAIN_REASONING', native: { encrypted: 'reference-only' } });
+    const snapshot = [user('main', 'Main task'), running];
+    const before = JSON.stringify(snapshot);
+    const next = buildLiveBtwMessages({ ...input, snapshot, turns: [] });
+    expect(JSON.stringify(snapshot)).toBe(before);
+    expect(next.messages[1]).toMatchObject({ type: 'assistant', content: running.content, native: running.native, time: { created: 19, completed: 20 } });
+    expect(next.messages[1].id).not.toBe(running.id);
+    expect(next.boundaryMessageID).toBe(next.messages[1].id);
+    const premise = next.messages.at(-1)?.metadata?.openchamberLiveBtwBasis;
+    expect(premise).toMatchObject({ text: 'Current main progress', completed: false });
+  });
+
+  test('preserves user attachments and explicit quoted context', () => {
+    const question = { ...user('question', 'Explain the attachment'), files: [{
+      mime: 'text/plain', data: 'YXR0YWNobWVudA==', source: { type: 'inline' as const }, name: 'reference.txt',
+    }] };
+    const quoted: SessionMessageInfo = { id: 'quote', type: 'synthetic', text: 'Quoted user context',
+      time: { created: 16 }, metadata: { openchamberContext: { kind: 'chat-quote', quote: 'Selected passage', text: 'Quoted user context' } } };
+    const turns = collectLiveBtwTurns([end, quoted, question, assistant('answer', 'Attachment answer')], null);
+    const next = buildLiveBtwMessages({ ...input, snapshot: [], turns });
+    expect(next.messages.find((message) => message.type === 'user')).toMatchObject({ text: question.text, files: question.files });
+    expect(next.messages.some((message) => message.type === 'synthetic' && message.text === quoted.text)).toBe(true);
+  });
+
+  test('deduplicates premise text while retaining the premise on each question', () => {
+    const nextBasis = { ...end, id: 'new-basis', metadata: { openchamberLiveBtwBasis: { ...basis, messageID: 'reminted-main-id', snapshotAt: 30 } } };
+    const turns = collectLiveBtwTurns([end, user('q1', 'First'), assistant('a1', 'First answer'), nextBasis, user('q2', 'Second'), assistant('a2', 'Second answer')], null);
+    const next = buildLiveBtwMessages({ ...input, snapshot: [], turns });
+    const text = next.messages.filter((message) => message.type === 'synthetic').map((message) => message.text).join('\n');
+    expect(text.split(basis.text)).toHaveLength(2);
+    expect(text).toContain('same main-session premise as side question 1');
+    const replay = collectLiveBtwTurns(next.messages, null);
+    expect(replay.map((turn) => turn.basis)).toEqual([basis, nextBasis.metadata.openchamberLiveBtwBasis]);
+  });
+
+  test('does not replay a reverted question and keeps stable links across repeated rebuilds', () => {
+    const previous = [end, user('q1', 'First'), assistant('a1', 'First answer'), user('q2', 'Removed')];
+    const turns = collectLiveBtwTurns(previous, null, 'q2', 'original-head');
+    const replay = buildLiveBtwMessages({ ...input, snapshot: [], turns });
+    expect(replay.messages.filter((message) => message.type === 'user')).toHaveLength(1);
+    const replayed = collectLiveBtwTurns(replay.messages, null, undefined, 'new-head');
+    expect(replayed[0]?.user.metadata?.openchamberLiveBtwOrigin).toEqual({ sessionID: 'original-head', messageID: 'q1' });
+    expect(replayed[0]?.answer?.metadata?.openchamberLiveBtwOrigin).toEqual({ sessionID: 'original-head', messageID: 'a1' });
+  });
+
+  test('a missing inherited boundary fails instead of dropping prior questions', () => {
+    expect(() => collectLiveBtwTurns([user('question', 'Keep this')], 'missing')).toThrow('boundary is missing');
+  });
+
+  test('a main session without an answer has an explicit empty premise', () => {
+    expect(liveBtwBasis([user('main', 'Still starting')], 100)).toEqual({ messageID: null, text: '', snapshotAt: 100, completed: false });
+  });
+});
diff --git a/packages/ui/src/lib/opencode/live-btw-context.ts b/packages/ui/src/lib/opencode/live-btw-context.ts
new file mode 100644
index 0000000..6e37c24
--- /dev/null
+++ b/packages/ui/src/lib/opencode/live-btw-context.ts
@@ -0,0 +1,126 @@
+import type { SessionMessageInfo } from '@opencode/client';
+import { z } from 'zod';
+import { ascendingId } from './ids';
+
+const basisSchema = z.object({
+  messageID: z.string().nullable(),
+  text: z.string(),
+  snapshotAt: z.number().finite(),
+  completed: z.boolean(),
+});
+
+type LiveBtwBasis = z.infer<typeof basisSchema>;
+type User = Extract<SessionMessageInfo, { type: 'user' }>;
+type Assistant = Extract<SessionMessageInfo, { type: 'assistant' }>;
+type Synthetic = Extract<SessionMessageInfo, { type: 'synthetic' }>;
+type LiveBtwTurn = { user: User; answer: Assistant | null; basis: LiveBtwBasis | null; context: Synthetic[] };
+type LiveBtwTranscript = { messages: SessionMessageInfo[]; boundaryMessageID: string | null };
+
+export const liveBtwBasis = (messages: readonly SessionMessageInfo[], snapshotAt: number): LiveBtwBasis => {
+  for (let index = messages.length - 1; index >= 0; index -= 1) {
+    const message = messages[index]!;
+    if (message.type !== 'assistant') continue;
+    const text = message.content.filter((part) => part.type === 'text').map((part) => part.text).join('\n\n');
+    if (text.trim()) return { messageID: message.id, text, snapshotAt, completed: Boolean(message.time.completed) };
+  }
+  return { messageID: null, text: '', snapshotAt, completed: false };
+};
+
+export const collectLiveBtwTurns = (
+  messages: readonly SessionMessageInfo[],
+  boundaryMessageID: string | null,
+  revertMessageID?: string,
+  sourceSessionID?: string,
+): LiveBtwTurn[] => {
+  const boundary = boundaryMessageID ? messages.findIndex((message) => message.id === boundaryMessageID) : -1;
+  if (boundaryMessageID && boundary < 0) throw new Error('The live BTW history boundary is missing.');
+  const end = revertMessageID ? messages.findIndex((message) => message.id === revertMessageID) : messages.length;
+  if (end < 0) throw new Error('The live BTW undo boundary is missing.');
+  const turns: LiveBtwTurn[] = [];
+  let basis: LiveBtwBasis | null = null;
+  let context: Synthetic[] = [];
+  let current: LiveBtwTurn | null = null;
+  for (const message of messages.slice(boundary + 1, Math.max(boundary + 1, end))) {
+    const parsed = basisSchema.safeParse(message.metadata?.openchamberLiveBtwBasis);
+    if (parsed.success) basis = parsed.data;
+    if (message.type === 'user') {
+      current = { user: withOrigin(message, sourceSessionID), answer: null, basis, context };
+      turns.push(current);
+      context = [];
+    } else if (message.type === 'assistant' && current && message.time.completed
+      && message.finish !== 'tool-calls' && message.finish !== 'error'
+      && !message.content.some((part) => part.type === 'tool')) {
+      const content = message.content.filter((part) => part.type === 'text').map((part) => ({ type: 'text' as const, text: part.text }));
+      if (content.some((part) => part.text.trim())) {
+        current.answer = withOrigin({ ...message, content, native: undefined, snapshot: undefined }, sourceSessionID);
+      }
+    } else if (message.type === 'synthetic' && isAttachedContext(message.metadata)) {
+      // Explicit user context, such as a quoted selection, remains attached to its question.
+      context.push(message);
+    }
+  }
+  return turns;
+};
+
+const withOrigin = <T extends User | Assistant>(message: T, sessionID?: string): T => ({
+  ...message, metadata: { ...message.metadata, openchamberLiveBtwOrigin: message.metadata?.openchamberLiveBtwOrigin
+    ?? { sessionID: sessionID ?? '', messageID: message.id } },
+});
+
+// Preserve context carriers. The native UI validates and renders their structured payloads.
+const attachedContextSchema = z.object({ kind: z.string() });
+const attachedCommentSchema = z.object({ path: z.string(), comment: z.string() });
+const isAttachedContext = (metadata: SessionMessageInfo['metadata']): boolean => {
+  const value = metadata?.openchamberContext;
+  const comment = metadata?.opencodeComment;
+  return attachedContextSchema.safeParse(value).success || attachedCommentSchema.safeParse(comment).success;
+};
+
+const synthetic = (text: string, metadata?: Synthetic['metadata']): Synthetic => ({
+  id: ascendingId('msg'), type: 'synthetic', text, metadata, time: { created: Date.now() },
+});
+
+export const buildLiveBtwMessages = (input: {
+  snapshot: readonly SessionMessageInfo[];
+  turns: readonly LiveBtwTurn[];
+  start: string;
+  end: string;
+  snapshotAt: number;
+}): LiveBtwTranscript => {
+  // A running assistant becomes a settled reference copy. Its content stays intact.
+  const snapshot = input.snapshot.map((message): SessionMessageInfo => {
+    const id = ascendingId('msg');
+    if (message.type === 'assistant' && !message.time.completed) {
+      return { ...message, id, time: { ...message.time, completed: input.snapshotAt } };
+    }
+    return { ...message, id };
+  });
+  const boundaryMessageID = snapshot.at(-1)?.id ?? null;
+  const messages: SessionMessageInfo[] = [...snapshot, synthetic(input.start, { openchamberLiveBtwStart: true })];
+  const premises = new Map<string, number>();
+  for (const [index, turn] of input.turns.entries()) {
+    const premise = turn.basis;
+    if (premise) {
+      const key = JSON.stringify([premise.completed, premise.text]);
+      const previous = premises.get(key);
+      const text = previous === undefined
+        ? `Main-session premise for side question ${index + 1}, captured at the time of that question:\n${JSON.stringify(premise)}`
+        : `Side question ${index + 1} uses the same main-session premise as side question ${previous + 1}.`;
+      if (previous === undefined) premises.set(key, index);
+      messages.push(synthetic(text, { openchamberLiveBtwBasis: premise }));
+    }
+    for (const part of turn.context) messages.push({ ...part, id: ascendingId('msg') });
+    messages.push({ ...turn.user, id: ascendingId('msg') });
+    if (turn.answer) messages.push({ ...turn.answer, id: ascendingId('msg') });
+  }
+  messages.push(synthetic(input.end, {
+    openchamberLiveBtwEnd: true,
+    openchamberLiveBtwBasis: liveBtwBasis(input.snapshot, input.snapshotAt),
+  }));
+  return {
+    messages: messages.map((message, index) => ({
+      ...message, metadata: { ...message.metadata, openchamberLiveBtwOrder: index },
+    })),
+    boundaryMessageID,
+  };
+};
diff --git a/packages/ui/src/lib/opencode/live-btw-transport.ts b/packages/ui/src/lib/opencode/live-btw-transport.ts
new file mode 100644
index 0000000..306fa91
--- /dev/null
+++ b/packages/ui/src/lib/opencode/live-btw-transport.ts
@@ -0,0 +1,114 @@
+import type { OpenCodeClient, SessionInfo, SessionMessageInfo } from '@opencode/client';
+import { LIVE_BTW_RPC } from '@openchamber/sdk';
+import { buildLiveBtwMessages, collectLiveBtwTurns } from './live-btw-context';
+import { descendingId } from './ids';
+import { withBtwSessionMarker } from '../sessionBtwMetadata';
+import { LIVE_BTW_PROMPT_START, LIVE_BTW_PROMPT_END } from '../liveBtwPrompts';
+import { BTW_READ_ONLY_INSTRUCTION } from '../btwReadOnly';
+import { z } from 'zod';
+
+export const liveBtwLeaseSchema = z.object({ rootSessionID: z.string(), parentSessionID: z.string(), previousSessionID: z.string(), token: z.string() });
+export type LiveBtwLease = z.infer<typeof liveBtwLeaseSchema>;
+const marker = (info: SessionInfo) => z.object({
+  btwBoundaryMessageID: z.string().optional(), btwLiveHeadSessionID: z.string().optional(),
+}).passthrough().parse(info.metadata?.openchamber ?? {});
+// SAFETY: OpenCode records contain JSON values. Serialization removes optional undefined fields without changing their contract.
+const asJSON = <T>(value: T): T => JSON.parse(JSON.stringify(value)) as T;
+
+/** Official SDK operations stay at this adapter boundary; the coordinator owns cross-client admission. */
+export async function buildLiveBtwTranscript(input: {
+  sdk: () => OpenCodeClient;
+  directory: string;
+  lease: LiveBtwLease;
+  check: () => void;
+  cleanup: (sessionID: string) => Promise<void>;
+  materialize: (session: SessionInfo) => Promise<void>;
+}): Promise<{ session: SessionInfo; root: SessionInfo }> {
+  const { lease, sdk, check } = input;
+  let snapshotID: string | undefined;
+  let preparedID: string | undefined;
+  const request = async <T>(call: (client: OpenCodeClient) => Promise<T>): Promise<T> => {
+    check(); const value = await call(sdk()); check(); return value;
+  };
+  try {
+    const active = await request((client) => client.session.active());
+    if (Object.hasOwn(active, lease.previousSessionID)) throw new Error('Wait for the current live BTW answer before sending another question.');
+    const previous = await request((client) => client.session.get({ sessionID: lease.previousSessionID }));
+    check();
+    const snapshot = await sdk().session.fork({ sessionID: lease.parentSessionID });
+    snapshotID = snapshot.id;
+    check();
+    const safeMetadata = withBtwSessionMarker(snapshot.metadata ?? {}, lease.parentSessionID, null, 'side', { mode: 'live', liveRootSessionID: lease.rootSessionID });
+    await request((client) => client.session.update({ sessionID: snapshot.id, metadata: safeMetadata }));
+    preparedID = descendingId('ses');
+    await request((client) => client.rpc(LIVE_BTW_RPC).track({ rootSessionID: lease.rootSessionID, token: lease.token,
+      temporarySessionID: snapshot.id, candidateSessionID: preparedID! }, { location: { directory: input.directory } }));
+    const history = await request((client) => client.session.context({ sessionID: snapshot.id }));
+    const entries = await request((client) => client.experimental.session.instructions.entry.list({ sessionID: snapshot.id }));
+    const previousMessages: SessionMessageInfo[] = [];
+    const boundary = marker(previous).btwBoundaryMessageID ?? null;
+    let cursor: string | undefined;
+    do {
+      const page = await request((client) => client.message.list({ sessionID: previous.id, limit: 200,
+        ...(cursor ? { cursor } : { order: 'desc' as const }) }));
+      previousMessages.push(...page.data);
+      if (boundary && page.data.some((message) => message.id === boundary)) break;
+      cursor = page.data.length === 200 ? page.cursor.next ?? undefined : undefined;
+    } while (cursor);
+    const replay = buildLiveBtwMessages({ snapshot: history,
+      turns: collectLiveBtwTurns(previousMessages.reverse(), boundary, previous.revert?.messageID, previous.id),
+      start: `${LIVE_BTW_PROMPT_START}\n${BTW_READ_ONLY_INSTRUCTION}`, end: LIVE_BTW_PROMPT_END, snapshotAt: snapshot.time.created,
+    });
+    const metadata = withBtwSessionMarker(snapshot.metadata ?? {}, lease.parentSessionID, replay.boundaryMessageID, 'side', {
+      mode: 'live', liveRootSessionID: lease.rootSessionID, snapshotAt: snapshot.time.created,
+    });
+    const origins: Record<string, string> = {};
+    for (const message of replay.messages) {
+      const source = z.object({ sessionID: z.string(), messageID: z.string() }).safeParse(message.metadata?.openchamberLiveBtwOrigin);
+      if (source.success) origins[JSON.stringify([source.data.sessionID, source.data.messageID])] = message.id;
+    }
+    metadata.openchamber = { ...marker({ ...snapshot, metadata }), btwCoordinatorVersion: 2, btwLiveOrigins: origins };
+    const session = await request((client) => client.experimental.session.import({
+      info: { ...snapshot, id: preparedID!, parentID: lease.rootSessionID, fork: undefined, title: 'live-btw-context', metadata,
+        permissions: previous.permissions ?? snapshot.permissions, cost: 0,
+        tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+        time: { created: Date.now(), updated: Date.now() }, outcome: undefined, revert: undefined,
+      }, messages: replay.messages.map((message) => asJSON({ ...message })), location: snapshot.location,
+    }));
+    for (const entry of entries) await request((client) => client.experimental.session.instructions.entry.put({ sessionID: session.id, ...entry }));
+    await input.materialize(session);
+    check();
+    await request((client) => client.rpc(LIVE_BTW_RPC).publish({ rootSessionID: lease.rootSessionID, sessionID: session.id, token: lease.token }, { location: { directory: input.directory } }));
+    const root = await request((client) => client.session.get({ sessionID: lease.rootSessionID }));
+    return { session, root };
+  } catch (error) {
+    if (preparedID) {
+      // A lost publish response can still have advanced the root. Preserve it until that read succeeds.
+      let current = true;
+      try { check(); } catch { current = false; }
+      const root = current ? await sdk().session.get({ sessionID: lease.rootSessionID }).catch(() => null) : null;
+      if (root && marker(root).btwLiveHeadSessionID !== preparedID) await input.cleanup(preparedID).catch(() => {});
+    }
+    throw error;
+  } finally {
+    if (snapshotID) await input.cleanup(snapshotID).catch((error) => console.warn('Temporary BTW snapshot cleanup remains pending:', error));
+  }
+}
+
+/** Clear only retired transcript data. Tiny redirect sessions preserve links and stay outside the main session. */
+export async function finishLiveBtwTranscript(sdk: OpenCodeClient, lease: LiveBtwLease, directory: string, accepted: boolean): Promise<void> {
+  const location = { directory };
+  const result = z.object({ retire: z.array(z.string()).optional() }).parse(await sdk.rpc(LIVE_BTW_RPC).finish({ rootSessionID: lease.rootSessionID, token: lease.token, accepted }, { location }));
+  for (const sessionID of result.retire ?? []) {
+    try {
+      const active = await sdk.session.active();
+      if (Object.hasOwn(active, sessionID)) continue;
+      const first = await sdk.message.list({ sessionID, limit: 1, order: 'asc' });
+      if (first.data[0]) {
+        await sdk.session.revert.stage({ sessionID, messageID: first.data[0].id, files: false });
+        await sdk.session.revert.commit({ sessionID });
+      }
+      await sdk.rpc(LIVE_BTW_RPC).retired({ rootSessionID: lease.rootSessionID, sessionID }, { location });
+    } catch (error) { console.warn('Retired BTW snapshot cleanup will retry on the next send:', error); }
+  }
+}
